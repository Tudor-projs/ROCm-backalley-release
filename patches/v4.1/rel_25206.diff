+static __device__ __forceinline__ size_t ggml_cuda_index_4d(
+        const int64_t i0, const int64_t i1, const int64_t i2, const int64_t i3,
+        const int64_t ne0, const int64_t ne1, const int64_t ne2, const int64_t ne3,
